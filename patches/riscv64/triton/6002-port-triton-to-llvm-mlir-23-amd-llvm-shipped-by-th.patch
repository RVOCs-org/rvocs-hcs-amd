From 622529583b468e4ed6ffed012e4d6a9657035a38 Mon Sep 17 00:00:00 2001
From: zhengguangchun <zhengguangchun@metastonecorp.com>
Date: Sun, 20 Sep 2026 09:37:41 +0800
Subject: [PATCH] Port triton to LLVM/MLIR 23 (amd-llvm shipped by TheRock
 10.0)

Adaptations required to build against the LLVM/MLIR 23 toolchain from
TheRock 10.0 (clang23/lld), enabling riscv64 gfx1201 targets:

- 8 dialect .td files updated for LLVM 23 tablegen
- Dialect.h x4: getName() const (MLIR 23 API)
- python/src/llvm.cc: NoInfs/NoNaNs fast-math flags removed in
  LLVM 23; OptLevel Os/Oz no longer accepted -> O2
- inferReturnTypes PropertyRef signature x9 call sites
- LLVMDIUtils: extended DI API parameters
- third_party/nvidia: -Werror fixes (DenseTypedElementsAttr,
  BarrierOp), MCContext ctor, MCAsmParser 3-arg form
- third_party/amd: TargetInfo/TargetUtils/Dialect adjustments,
  AMDGPUTargetParser include

Verified on RISC-V 9700 (gfx1201): TRITON_OK (import + GPU smoke
test); full vLLM stack builds with this tree.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 604b942e18af20fe396cac75c29f2482e4a96efd..c43d1dd3b03bd1322a3ad6caa1abe3d1751c05b0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,7 +17,7 @@ list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 
 # Options
 option(TRITON_BUILD_PYTHON_MODULE "Build Python Triton bindings" OFF)
-option(TRITON_BUILD_PROTON "Build the Triton Proton profiler" ON)
+option(TRITON_BUILD_PROTON "Build the Triton Proton profiler" OFF)
 option(TRITON_BUILD_UT "Build C++ Triton Unit Tests" ON)
 option(TRITON_BUILD_WITH_CCACHE "Build with ccache (if available)" ON)
 option(TRITON_OFFLINE_BUILD "Build without downloading dependencies" OFF)
@@ -114,6 +114,11 @@ include(TableGen) # required by AddMLIR
 include(AddLLVM)
 include(AddMLIR)
 
+# riscv64 wheel: .md doc generation useless and errors (multi-dialect td without -dialect) — neuter
+function(add_mlir_doc)
+endfunction()
+
+
 # Utilities
 function(add_triton_object name)
   cmake_parse_arguments(ARG "" "" "DEPENDS;LINK_LIBS" ${ARGN})
@@ -228,6 +233,11 @@ if(TRITON_BUILD_PYTHON_MODULE)
   get_property(triton_libs GLOBAL PROPERTY TRITON_LIBS)
   get_property(triton_plugins GLOBAL PROPERTY TRITON_PLUGINS)
   set(TRITON_LIBRARIES
+    # riscv64 wheel: LLVM shared monolith FIRST - all LLVM refs resolve
+    # dynamically so NO static LLVM member (e.g. PassBuilder.o from
+    # libLLVMPasses.a) gets embedded into libtriton.so; embedding caused
+    # duplicate cl::opt registration crash at import
+    ${LLVM_LIBRARY_DIR}/libLLVM.so
     ${triton_libs}
     ${triton_plugins}
 
@@ -257,7 +267,9 @@ if(TRITON_BUILD_PYTHON_MODULE)
 
     # LLVM
     LLVMPasses
-    LLVMNVPTXCodeGen
+    ${LLVM_LIBRARY_DIR}/libLLVMNVPTXCodeGen.a
+    ${LLVM_LIBRARY_DIR}/libLLVMNVPTXDesc.a
+    ${LLVM_LIBRARY_DIR}/libLLVMNVPTXInfo.a
     # LLVMNVPTXAsmPrinter
     LLVMAMDGPUCodeGen
     LLVMAMDGPUAsmParser
