--- a/cmake/therock_primlibs_benchmark_deps.cmake
+++ b/cmake/therock_primlibs_benchmark_deps.cmake
@@ -10,7 +10,20 @@
 #
 # TODO(https://github.com/ROCm/TheRock/issues/4651): Remove once upstream
 # rocPRIM adds its own find_package(amd_smi).
+#
+# fix #12 (riscv64, 2026-09-13): This file is included from generated
+# _init.cmake during project()'s CMAKE_PROJECT_TOP_LEVEL_INCLUDES phase,
+# i.e. BEFORE platform info is loaded. CMake >= 4.x (4.2.3) rejects
+# add_library(... SHARED IMPORTED) executed in that phase ("ADD_LIBRARY
+# called with SHARED option but the target platform does not support dynamic
+# linking" - rocRAND configure failures in v12 and v13). CMAKE_SYSTEM_
+# PROCESSOR is already set even in that phase (v13 proved it), so it cannot
+# serve as a phase probe. Instead, defer the real find_package to the LAST
+# step of the current project() call via CMAKE_PROJECT_INCLUDE: languages
+# are enabled by then, and the imported target still exists before any
+# benchmark subdirectory is processed.
 
 if(NOT TARGET amd_smi)
-  find_package(amd_smi REQUIRED CONFIG)
+  set(CMAKE_PROJECT_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/therock_amdsmi_deferred.cmake")
+  message(STATUS "amd_smi: deferring find_package to end of project() via CMAKE_PROJECT_INCLUDE")
 endif()
