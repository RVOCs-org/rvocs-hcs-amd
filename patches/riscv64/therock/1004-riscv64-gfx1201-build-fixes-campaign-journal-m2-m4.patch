-      set(FLANG_RUNTIME_F128_MATH_LIB "libquadmath")
+      # riscv64 guard (fix #8, 2026-09-13): libquadmath is x86-only. On
+      # riscv64 long double is IEEE binary128 (LDBL_MANT_DIG=113), so REAL(16)
