diff --git a/aten/src/ATen/hip/ScanUtils.cuh b/aten/src/ATen/hip/ScanUtils.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..d6766257b49d6d6a7e057b95a53566805c1eaee3
