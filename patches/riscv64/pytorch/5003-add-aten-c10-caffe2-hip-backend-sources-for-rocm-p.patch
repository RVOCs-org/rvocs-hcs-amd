+      -42L,
+      0L,
+      42L
+    };
+    tos = {
+      ::std::optional<int64_t>(-42L),
+      ::std::optional<int64_t>(0L),
+      ::std::optional<int64_t>(42L),
+      ::std::optional<int64_t>(max_to),
+      static_cast<::std::optional<int64_t>>(::std::nullopt)
+    };
+  } else {
+    froms = {
+      0L,
+      42L
+    };
+    tos = {
+      ::std::optional<int64_t>(42L),
+      ::std::optional<int64_t>(max_to),
+      static_cast<::std::optional<int64_t>>(::std::nullopt)
+    };
+  }
