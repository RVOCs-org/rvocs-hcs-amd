+       log_probs.stride(0), log_probs.stride(1), log_probs.stride(2),
+       log_alpha.stride(0), log_alpha.stride(1), log_alpha.stride(2),
+       log_beta.stride(0), log_beta.stride(1), log_beta.stride(2),
