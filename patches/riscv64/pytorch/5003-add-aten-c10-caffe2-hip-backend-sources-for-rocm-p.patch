+  AT_DISPATCH_FLOATING_TYPES_AND2(kHalf, kBFloat16, grad_output.scalar_type(),
+                                  "conv_depthwise2d_grad_weight_cuda", [&] {
+    const auto grad_output_a = grad_output.packed_accessor32<const scalar_t, 4>();
