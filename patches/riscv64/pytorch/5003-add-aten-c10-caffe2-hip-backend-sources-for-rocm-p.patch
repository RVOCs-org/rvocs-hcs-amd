+template <typename T, typename T_ACC>
+__global__ void ComputeFusedParamsCUDAKernel(
+    int64_t N,
+    int64_t C,
+    int64_t group,
+    const T_ACC* mean,
+    const T_ACC* rstd,
+    const T* gamma,
