+  };
+
+ public:
+  /**
+   * Sorts the array/container arr.
+   * \param  arr  The array/container to be sorted.
+   */
+  template <class Container>
+  CUTLASS_HOST_DEVICE void operator()(Container& arr) const {
+    PS<Container, 1, NumElements, (NumElements <= 1)> ps(arr);
+  };
