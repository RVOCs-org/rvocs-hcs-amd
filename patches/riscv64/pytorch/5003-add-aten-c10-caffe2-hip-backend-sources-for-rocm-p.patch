+// See [CUDA kernel for chunk_cat_cuda]
+template <typename dst_t, typename src_t>
+void _chunk_cat_out_cuda_contiguous(
+    TensorList tensors,
+    int64_t dim,
+    int64_t num_chunks,
+    Tensor& out,
+    int64_t dst_elem_size,
+    int64_t src_elem_size) {
