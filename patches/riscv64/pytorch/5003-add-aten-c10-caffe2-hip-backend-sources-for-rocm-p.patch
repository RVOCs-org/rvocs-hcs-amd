+                            i_compressed * out_stride_compressed +
+                            i_plain * out_stride_plain;
+                        out_ptr[index] += cast_value *
+                            values_accessor[batch_idx * val_stride0 + i];
+                      }
+                    }
+                  });
+            });
+      });
+  if (output.scalar_type() != commonDtype) {
+    output.copy_(resultBuffer);
+  }
+  return output;
+}
