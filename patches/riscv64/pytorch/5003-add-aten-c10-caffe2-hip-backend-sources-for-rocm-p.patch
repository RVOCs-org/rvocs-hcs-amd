+        _case.customCheck.emplace_back(customArgs);
+        return *this;
+    }
+    TestCaseBuilder<T, U>& checkSpecialValues() {
+        _case.specialCheck = true;
+        return *this;
+    }
+    TestCaseBuilder<T, U>& compareBitwise() {
+        _case.bitwise = true;
+        return *this;
+    }
+    operator TestingCase<T, U> && () { return std::move(_case); }
