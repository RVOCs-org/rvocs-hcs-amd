+// makes the functor
+#define STD_FUNCTOR(op_name, functor_name) \
+  template <typename T>                    \
+  struct functor_name {                    \
+    __device__ T operator()(T t) const {   \
+      return std::op_name(t);              \
+    }                                      \
+  };
