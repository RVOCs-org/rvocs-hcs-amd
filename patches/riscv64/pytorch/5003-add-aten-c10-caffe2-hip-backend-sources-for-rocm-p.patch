+          self,
+          at::native::scalar_tensor(
+              beta,
+              self.scalar_type(),
+              std::nullopt /* layout */,
+              at::kCPU,
+              std::nullopt /* pin_memory */));
+    }
+  }
+
+  sparse::impl::cuda::addmv_out_sparse_csr(mat, vec, beta, alpha, result);
+  return result;
