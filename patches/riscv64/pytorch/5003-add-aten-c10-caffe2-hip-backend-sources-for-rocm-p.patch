+struct PreventFma
+{
+    not_inline float sub(float a, float b)
+    {
+        return a - b;
+    }
+    not_inline double sub(double a, double b)
+    {
+        return a - b;
+    }
+    not_inline float add(float a, float b)
+    {
+        return a + b;
+    }
+    not_inline double add(double a, double b)
+    {
+        return a + b;
+    }
+};
