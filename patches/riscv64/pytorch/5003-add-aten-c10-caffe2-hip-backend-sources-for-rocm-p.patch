+static std::string reportProcessMemoryInfo(const hipDeviceProp_t& prop) {
+#ifdef PYTORCH_C10_DRIVER_API_SUPPORTED
+  void* nvml_handle = DriverAPI::get_nvml_handle();
+  if (!nvml_handle) {
+    return "";
+  }
+  static bool nvml_init [[maybe_unused]] = []() {
+    TORCH_INTERNAL_ASSERT(RSMI_STATUS_SUCCESS == DriverAPI::get()->nvmlInit_v2_());
+    return true;
+  }();
+
+  // NOLINTNEXTLINE(*-c-arrays)
+  char pci_id[80];
+  snprintf(
+      pci_id,
+      sizeof(pci_id),
+      NVML_DEVICE_PCI_BUS_ID_FMT,
+      prop.pciDomainID,
+      prop.pciBusID,
+      prop.pciDeviceID);
+
+  uint32_t nvml_device = nullptr;
+  TORCH_INTERNAL_ASSERT(
+      RSMI_STATUS_SUCCESS ==
+      DriverAPI::get()->nvmlDeviceGetHandleByPciBusId_v2_(
+          pci_id, &nvml_device));
+
+  std::vector<nvmlProcessInfo_v1_t> procs(8);
+  unsigned int size = procs.size();
+  rsmi_status_t r{};
+  while ((r = DriverAPI::get()->nvmlDeviceGetComputeRunningProcesses_(
+              nvml_device, &size, procs.data())) ==
+         RSMI_STATUS_INSUFFICIENT_SIZE) {
+    procs.resize(size);
+  }
+  unsigned int self_pid = getpid();
+  std::stringstream ss;
+  TORCH_INTERNAL_ASSERT(RSMI_STATUS_SUCCESS == r);
+  ss << "";
+  for (auto i : c10::irange(size)) {
+    auto& proc = procs[i];
+    if (self_pid == proc.pid) {
+      ss << "Including non-PyTorch memory, this process";
+    } else {
+      ss << "Process " << proc.pid;
+    }
+    ss << " has " << format_size(proc.usedGpuMemory) << " memory in use. ";
+  }
+  return ss.str();
+#else
+  return "";
+#endif
+}
