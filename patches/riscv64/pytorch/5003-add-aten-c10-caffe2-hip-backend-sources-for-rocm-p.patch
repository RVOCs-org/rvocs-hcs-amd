+  // Get the bit field of [pos, pos+len) bits from val:
+  // (val >> pos) && ( (1u << len) - 1u )
+  asm("bfe.u32 %0, %1, %2, %3;" : "=r"(ret) : "r"(val), "r"(pos), "r"(len));
+  return __uint2float_rn(ret);
+#endif
