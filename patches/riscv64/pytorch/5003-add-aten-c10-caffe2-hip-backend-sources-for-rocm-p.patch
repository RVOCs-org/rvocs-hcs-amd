+template <typename T, typename Op>
+T func_cmp(Op call, T v0, T v1) {
+    using bit_rep = BitType<T>;
+    constexpr bit_rep mask = std::numeric_limits<bit_rep>::max();
+    bit_rep  ret = call(v0, v1) ? mask : 0;
+    return c10::bit_cast<T>(ret);
+}
