+      stride,
+      dilation,
+      groups,
+      deterministic,
+      allow_tf32);
+  // TODO: is this thread safe if cache is updated? is pointer stale?
+  auto search = _get_benchmark_cache()->find(key);
+  if (search) {
+    try {
+      run_conv_plan(handle, x, y, w, *search, operation);
