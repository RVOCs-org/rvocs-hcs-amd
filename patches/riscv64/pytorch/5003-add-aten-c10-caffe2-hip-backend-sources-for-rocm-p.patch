+void sleep(int64_t cycles) {
+  dim3 grid(1);
+  dim3 block(1);
+  spin_kernel<<<grid, block, 0, c10::cuda::getCurrentCUDAStream()>>>(cycles);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
