+    void* dst,
+    const void* src,
+    int64_t nbytes,
+    hipMemcpyKind kind,
+    hipStream_t stream) {
+  if (C10_UNLIKELY(
+          warning_state().get_sync_debug_mode() != SyncDebugMode::L_DISABLED)) {
+    warn_or_error_on_sync();
