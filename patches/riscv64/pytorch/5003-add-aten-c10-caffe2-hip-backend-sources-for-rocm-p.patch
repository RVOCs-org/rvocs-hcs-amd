+void renorm_scale_factor_impl(TensorIteratorBase& iter, double maxnorm) {
+  AT_DISPATCH_FLOATING_TYPES(iter.common_dtype(), "renorm_scale_factor_cpu", [&] {
+    const auto maxnorm_s = static_cast<scalar_t>(maxnorm);
+    gpu_kernel(
