+template <typename T>
+__global__ void GammaBeta1dBackwardCUDAKernel2(
+    int64_t N,
+    int64_t C,
+    int64_t group,
+    const T* dY,
+    const T* X,
+    const T* mean,
+    const T* rstd,
+    T* dgamma,
+    T* dbeta) {
+  using T_ACC = acc_type<T, true>;
