+uint32_t get_nvml_device(c10::DeviceIndex dev) {
+  static bool nvml_init [[maybe_unused]] = []() {
+    TORCH_INTERNAL_ASSERT(RSMI_STATUS_SUCCESS == DriverAPI::get()->nvmlInit_v2_());
+    return true;
+  }();
