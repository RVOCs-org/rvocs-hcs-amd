+    Tensor Bx = addBatchDim(x, /*lvl*/1, /*dim*/0);
+    Tensor By = addBatchDim(y, /*lvl*/1, /*dim*/0);
+    Tensor Bout = Bx * By;
+
+    const auto& out = maybeGetBatchedImpl(Bout)->value();
