+  // GPU will establish direct mapping of data in CPU memory, no page faults
+  // will be generated
+  C10_CUDA_CHECK_WO_DSA(hipMemAdvise(
+      uvm_assertions_ptr,
+      sizeof(DeviceAssertionsData),
+      hipMemAdviseSetAccessedBy,
+      cpuDevice));
