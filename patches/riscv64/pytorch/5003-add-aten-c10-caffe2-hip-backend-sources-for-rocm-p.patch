+    "unexpected int(hipStreamCaptureStatusActive) value");
+static_assert(
+    int(hipStreamCaptureStatus::hipStreamCaptureStatusInvalidated) == 2,
+    "unexpected int(hipStreamCaptureStatusInvalidated) value");
