+          ;
+        },
+        ::std::exception);
+  }
+
+  // Arrange: value should be a 0-dimensional value tensor or a scalar
+  {
+    const auto in_cpu =
+        at::rand({2, 3, 2}, at::device(at::kCPU).dtype(at::kFloat));
+    const auto mask_cpu =
