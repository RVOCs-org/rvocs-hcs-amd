+template <typename T>
+std::enable_if_t < !is_complex<T>::value, void> filter_add_overflow(T& a, T& b) {
+    if constexpr (std::is_integral_v<T> == false) return;
+    T max = std::numeric_limits<T>::max();
+    T min = std::numeric_limits<T>::min();
+    // min <= (a +b) <= max;
+    // min - b <= a  <= max - b
+    if (b < 0) {
+        if (a < min - b) {
+            a = min - b;
+        }
+    }
+    else {
+        if (a > max - b) {
+            a = max - b;
+        }
+    }
+}
