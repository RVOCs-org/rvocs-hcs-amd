+  int64_t maxThread = at::cuda::getCurrentDeviceProperties()->maxThreadsPerBlock;
+  int64_t maxGrid = 1024;
+  dim3 block = dim3(::min(maxThread, numel_in));
+  dim3 grid  = dim3(::min(maxGrid, ceil_div<int64_t>(numel_in, block.x)));
