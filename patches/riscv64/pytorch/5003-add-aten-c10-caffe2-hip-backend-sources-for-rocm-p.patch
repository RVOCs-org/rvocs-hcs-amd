+    static_assert(N % 2 == 0, "should be even");
+    auto ptr1 = vals;
+    auto ptr2 = vals + N / 2;
+    for (size_t i = 0; i < N; i += 2) {
+        interleaved[i] = *ptr1++;
+        interleaved[i + 1] = *ptr2++;
+    }
+}
