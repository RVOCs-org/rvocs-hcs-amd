+          load_store(r_args[i], args[i], 0, i_start);
+        }
+        sgd_math<scalar_t, opmath_t, depth>(
+            r_args,
+            weight_decay_opmath,
+            momentum_opmath,
+            lr_opmath,
+            dampening_opmath,
+            nesterov,
+            maximize,
+            is_first_step,
+            grad_scale_ptr);
