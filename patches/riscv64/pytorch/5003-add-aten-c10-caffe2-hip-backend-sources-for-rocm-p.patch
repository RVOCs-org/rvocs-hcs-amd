+
+void thread_func_get_set_current_seed(Generator generator) {
+  std::lock_guard<std::mutex> lock(generator.mutex());
+  auto current_seed = generator.current_seed();
+  current_seed++;
+  generator.set_current_seed(current_seed);
+}
