+        {batched_x, batched_y},
+        {
+          x.permute({1, 3, 0, 2}).view({B0, 1, B2, 1, 2, 3}),
+          y.permute({2, 0, 1}).view({1, B1, 1, B3, 1, 3}),
+        });
