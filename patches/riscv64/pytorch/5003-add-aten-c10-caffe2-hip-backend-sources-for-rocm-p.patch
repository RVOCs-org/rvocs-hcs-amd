+TEST_F(VulkanAPITest, masked_fill_scalar_mult4ch) {
+  test_masked_fill_scalar({3, 4, 5, 7}, {3, 4, 5, 7});
+}
+
+TEST_F(VulkanAPITest, masked_fill_scalar_nonmult4ch) {
+  test_masked_fill_scalar({3, 5, 2, 3}, {3, 5, 2, 3});
+}
