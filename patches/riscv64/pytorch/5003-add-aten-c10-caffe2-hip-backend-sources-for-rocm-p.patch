+#if defined(USE_ROCM) && defined(USE_ROCM_CK_GEMM)
+  else if (preferred == BlasBackend::Ck) {
+    at::native::gemm_internal_ck<at::Half>(CUDABLAS_GEMM_ARGS(at::Half));
