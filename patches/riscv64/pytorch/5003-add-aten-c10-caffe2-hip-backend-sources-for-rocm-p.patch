+    accscalar_t result = s[threadIdx.x];
+    accscalar_t norm_this_col = sqrtf(result);
+    norms[fast_dim_location] = norm_this_col;
+    rnorms_this_block[threadIdx.x] = 1.f/norm_this_col;
+  }
