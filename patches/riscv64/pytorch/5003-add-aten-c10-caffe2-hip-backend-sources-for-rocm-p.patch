+RNNDescriptor
+descriptor(miopenHandle_t handle, DropoutDescriptor&& dropout_desc) const {
+  RNNDescriptor rnn_desc;
+#ifndef USE_CUDNN_RNN_V8_API
+  rnn_desc.set(
+      handle,
+      hidden_size,
+      proj_size,
+      num_layers,
+      std::move(dropout_desc),
+      input_mode,
+      bidirectional,
+      mode,
+      datatype,
+      input_datatype,
+      algo,
+      at::globalContext().allowTF32CuDNN(at::Float32Op::RNN));
+#else
+    rnn_desc.set(
+        handle,
+        input_size,
+        packed,
+        hidden_size,
+        proj_size,
+        num_layers,
+        std::move(dropout_desc),
