+  res.y = bfe(packedVals, offset_bits + (1 * bits_per_dim), bits_per_dim);
+  res.z = bfe(packedVals, offset_bits + (2 * bits_per_dim), bits_per_dim);
+  res.w = bfe(packedVals, offset_bits + (3 * bits_per_dim), bits_per_dim);
