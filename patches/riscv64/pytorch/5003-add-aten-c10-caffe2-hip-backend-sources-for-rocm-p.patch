+  }
+
+  // Arrange: shapes of input tensor and mask tensor should be broadcastable
+  {
+    const auto in_cpu =
+        at::rand({2, 3, 2}, at::device(at::kCPU).dtype(at::kFloat));
+    const auto mask_cpu =
+        at::randint(0, 2, {3, 3, 2}, at::device(at::kCPU).dtype(at::kBool));
