+      "remove padding transform0213 only support output dim == 2");
+
+  remove_padding_transform0213_2<T><<<grid, BLOCK_DIM, 0, stream>>>(
+      input,
+      output,
+      offsets,
+      input_sizes,
+      output_sizes,
+      output_dim,
+      batch_size);
+}
