+
+hipError_t allocPrimitive(void** ptr, size_t size, AllocParams& p) {
+  if (p.pool->owner_PrivatePool && p.pool->owner_PrivatePool->allocator()) {
+    *ptr = p.pool->owner_PrivatePool->allocator()->raw_alloc(size);
+    return *ptr ? hipSuccess : hipErrorMemoryAllocation;
+  } else {
+    return C10_CUDA_ERROR_HANDLED(hipMalloc(ptr, size));
+  }
+}
+
+hipError_t cudaMallocMaybeCapturing(void** ptr, size_t size, AllocParams& p) {
+  if (at::cuda::currentStreamCaptureStatusMayInitCtx() ==
+      at::cuda::CaptureStatus::None) {
+    return allocPrimitive(ptr, size, p);
+  } else {
+    // It's ok to capture cudaMallocs, as long as we never hipFree those
+    // addresses before replay.
+    // Capturing hipMalloc behaves nicely: it gives the graph new VA,
+    // but is ignored (won't leakily allocate new memory) in replays.
+    at::cuda::CUDAStreamCaptureModeGuard g{hipStreamCaptureModeRelaxed};
+    return allocPrimitive(ptr, size, p);
+  }
+}
