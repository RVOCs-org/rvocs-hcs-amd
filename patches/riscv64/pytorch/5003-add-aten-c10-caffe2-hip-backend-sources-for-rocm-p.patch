+    [&] {
+      if (canUse32BitIndexMath(workspace)) { // See Note [64-bit index math check elision]
+        gru_forward_impl<scalar_t, int32_t>(input_gates, hidden_gates, input_bias, hidden_bias, hx, hy, workspace);
