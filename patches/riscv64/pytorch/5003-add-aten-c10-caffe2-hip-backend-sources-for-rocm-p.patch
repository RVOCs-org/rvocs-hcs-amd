+      // hipSparseLt 0.2.7: FP8 input only supports FP32 output
+      output_type = HIP_R_32F;
+      C_type = HIP_R_32F;
+#else
+      output_type = HIP_R_8F_E4M3;
+      C_type = HIP_R_16F;
+#endif
+      compute_type = HIPSPARSELT_COMPUTE_32F;
+      break;
+#endif
