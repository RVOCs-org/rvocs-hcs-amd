+    CUTLASS_HOST_DEVICE void s(T& v0, T& v1) {
+      // Explicitly code out the Min and Max to nudge the compiler
+      // to generate branchless code.
+      T t = v0 < v1 ? v0 : v1; // Min
+      v1 = v0 < v1 ? v1 : v0; // Max
+      v0 = t;
+    }
