+              // pattern varies a lot between slices along the compressed
+              // dimension.
+              thrust::for_each(
+                  policy,
+                  cccl_counting_iterator<int64_t>{0ll},
+                  cccl_counting_iterator<int64_t>{src_compressed_indices.size(-1) - 1},
+                  [values_accessor,
+                   compressed_indices_accessor,
+                   plain_indices_accessor,
+                   out_ptr,
+                   cast_value,
+                   out_stride_batch,
+                   out_stride_compressed,
+                   out_stride_plain,
+                   compressed_stride0,
+                   plain_stride0,
+                   val_stride0,
+                   batch_count] __device__(int64_t i_compressed) {
+                    for (index_t batch_idx = 0; batch_idx < batch_count;
