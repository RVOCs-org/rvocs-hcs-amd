+          output_type = HIP_R_16F;
+          break;
+        case at::ScalarType::BFloat16:
+          C_type = HIP_R_16BF;
+          output_type = HIP_R_16BF;
+          break;
+        case at::ScalarType::Int:
+          C_type = HIP_R_32I;
+          output_type = HIP_R_32I;
+          break;
+        default:
+          TORCH_CHECK(
+              false,
+              "Unsupported out_dtype passed, must be one of {fp16, bf16, int32} for int8 inputs");
+          break;
+      }
+    }
+// cslt 0.6.2+ or hipSparseLt: fp8 output dtype support
+#if defined(CUSPARSELT_VERSION) && CUSPARSELT_VERSION >= 602 || defined(USE_ROCM)
+    else if (input_type == HIP_R_8F_E4M3) {
+      switch (out_dtype) {
+#ifndef USE_ROCM
+        case at::ScalarType::Float8_e4m3fn:
+          output_type = HIP_R_8F_E4M3;
+          C_type = HIP_R_16F;
+          break;
+        case at::ScalarType::Half:
+          output_type = HIP_R_16F;
+          C_type = HIP_R_16F;
+          break;
+        case at::ScalarType::BFloat16:
+          output_type = HIP_R_16BF;
+          C_type = HIP_R_16BF;
+          break;
+#endif
+        case at::ScalarType::Float:
+          output_type = HIP_R_32F;
+          C_type = HIP_R_32F;
+          break;
