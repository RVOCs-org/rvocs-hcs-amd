+
+  #ifdef USE_ROCM
+  TORCH_CHECK(isHipSparseLtSupported());
+  #endif
+
+  switch (compressed_A.scalar_type()) {
+    case at::ScalarType::Char:
+      input_type = HIP_R_8I;
+      output_type = HIP_R_8I;
+      C_type = HIP_R_8I;
+      compute_type = HIPSPARSELT_COMPUTE_32I;
+      break;
