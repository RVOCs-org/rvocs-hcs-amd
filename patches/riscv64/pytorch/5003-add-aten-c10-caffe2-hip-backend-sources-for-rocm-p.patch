+// !!! This is a file automatically generated by hipify!!!
+#include "hip/hip_runtime.h"
+#include <ATen/native/nested/NestedTensorBinaryOps.h>
+
+#include <type_traits>
+
+#include <ATen/ATen.h>
+#include <ATen/Dispatch.h>
