+// !!! This is a file automatically generated by hipify!!!
+#define TORCH_ASSERT_ONLY_METHOD_OPERATORS
+#include <ATen/core/Tensor.h>
+#include <thrust/execution_policy.h>
+#include <thrust/sort.h>
