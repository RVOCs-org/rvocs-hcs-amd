+  auto booleanTrue = torch::ones({2, 3}).to(torch::kBool);
+  EXPECT_TRUE(eqTensor.toTensor().equal(booleanTrue));
+
+  // Test identity checking
+  EXPECT_TRUE(t.is(t));
+  EXPECT_FALSE(t.is(tCopy));
