+// to HIPSPARSELT_COMPUTE_32F
+#if defined(CUSPARSELT_VERSION) && CUSPARSELT_VERSION >= 502 || defined(USE_ROCM)
+    case at::ScalarType::Half:
+      input_type = HIP_R_16F;
+      output_type = HIP_R_16F;
+      C_type = HIP_R_16F;
+      compute_type = HIPSPARSELT_COMPUTE_32F;
+      break;
+    case at::ScalarType::BFloat16:
+      input_type = HIP_R_16BF;
+      output_type = HIP_R_16BF;
+      C_type = HIP_R_16BF;
+      compute_type = HIPSPARSELT_COMPUTE_32F;
+      break;
+#ifndef USE_ROCM
+    case at::ScalarType::Float:
+      input_type = HIP_R_32F;
+      output_type = HIP_R_32F;
+      C_type = HIP_R_32F;
+      compute_type = HIPSPARSELT_COMPUTE_32F;
