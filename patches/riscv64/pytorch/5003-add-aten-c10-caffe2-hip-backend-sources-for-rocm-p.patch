+      const int num_kernels = output_height * output_width;
+      const int num_threads = ::min(
+          at::cuda::getCurrentDeviceProperties()->maxThreadsPerBlock, 1024);
+      hipStream_t stream = at::cuda::getCurrentCUDAStream();
